# 依赖与构建产物（镜像内由 bun install / prisma generate 重新生成）
node_modules
.tmp
coverage
dist

# 版本控制与 IDE
.git
.gitignore
.vscode
.idea

# 日志与运行时上传文件（通过宿主机卷挂载，不进镜像）
logs
*.log
public/uploads

# 本地环境变量（运行时由 compose env_file 注入）
.env
.env.dev
.env.devLocal
.env.test
.env.prod

# 前端构建产物（独立发布到 nginx/html，不属于 server 镜像）
nginx/html

# 部署辅助
deploy/*.log
