# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="mysql://username:pwd@localhost:3306/dbname"
JWT_SECRET="xxxxxxxxx"

DATABASE_HOST="localhost"
DATABASE_NAME="dbname"
DATABASE_USER="username"
DATABASE_PASSWORD="pwd"
DATABASE_PORT=3306

NODE_ENV="production"

REDIS_URL="redis://localhost:6379"

# GitHub OAuth 登录（商户端）：在 GitHub Developer Settings 创建 OAuth App
# Authorization callback URL 必须与 GITHUB_REDIRECT_URI 完全一致（生产示例见下）。
# 切勿把 GITHUB_CLIENT_SECRET 提交到 Git；仅在服务器或 CI 密钥管理中配置。
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# 生产（与 hetou.vip 上 Nginx 转发的 /api 一致）：
GITHUB_REDIRECT_URI="https://hetou.vip/api/auth/github/callback"
# 本地开发可改为：http://127.0.0.1:<PORT>/nodejs_api/user/oauth/github/callback
# 前端站点根 URL，不要尾斜杠；OAuth 完成后 302 到此域下的 #/landing/oauth/callback
FRONTEND_URL="https://hetou.vip"
# 本地开发示例：FRONTEND_URL="http://localhost:5173"

# Microsoft To Do（Microsoft Graph）：无单独「API Key」，需在 Azure 注册应用并用 OAuth 取得用户委托 access_token。
# 生产环境建议由前端完成 MS 登录后把 access_token 放在请求头 X-Ms-Graph-Token；本地调试可临时填用户令牌：
# MICROSOFT_GRAPH_ACCESS_TOKEN=""