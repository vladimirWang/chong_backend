# Prisma 连接串（Prisma 7 从 prisma.config.ts 读取 datasource url）
DATABASE_URL="mysql://username:pwd@localhost:3306/gallery_hono_dev"
# 仅 prisma migrate dev / migrate diff 需要
SHADOW_DATABASE_URL="mysql://username:pwd@localhost:3306/gallery_hono_shadow"

NODE_ENV="development"

# 日志目录：仅 NODE_ENV=production 时按日写入文件（development 输出到 console）
# 容器内默认 /var/log/galleryrepo，本地默认可选 ./logs
# LOG_DIR="/var/log/galleryrepo"

# ClickHouse（访问量统计）—— 已禁用，恢复时取消注释
# CLICKHOUSE_URL="http://localhost:8123"

REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-me-in-prod"
