# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma 连接串（Prisma 7 从 prisma.config.ts 读取 datasource url）
DATABASE_URL="mysql://username:pwd@localhost:3306/gallery"
# 仅 prisma migrate dev / migrate diff 需要
SHADOW_DATABASE_URL="mysql://username:pwd@localhost:3306/gallery_shadow"

# 独立数据库连接字段（部分工具/脚本使用）
DATABASE_HOST="localhost"
DATABASE_NAME="gallery"
DATABASE_USER="root"
DATABASE_PASSWORD="change-me"
DATABASE_PORT=3306

JWT_SECRET="change-me-in-prod"

NODE_ENV="development"

# 日志目录：仅 NODE_ENV=production 时按日写入文件（development 输出到 console）
# SERVER_LOG_DIR="/var/log/galleryrepo_server"
# WORKER_LOG_DIR="/var/log/galleryrepo_worker"
# HOST_LOG_DIR="/var/log/galleryrepo"

# ClickHouse（访问量统计）—— 已禁用，恢复时取消注释
# CLICKHOUSE_URL="http://localhost:8123"

REDIS_URL="redis://localhost:6379"

PUBLIC_BASE_URL="http://localhost:4000"
PORT=4000

# GitHub OAuth：在部署环境填写 CLIENT_ID / CLIENT_SECRET（不要写进仓库）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:5174/api/auth/github/callback"

FRONTEND_URL="http://localhost:5174"

# 管理员用户
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SALT="change-me"

# 匿名用户（审计字段兜底）
ANONYMOUS_EMAIL="anonymous@example.com"
ANONYMOUS_USERNAME="anonymous"
ANONYMOUS_PASSWORD="change-me"
ANONYMOUS_SALT="change-me"

# QQ 邮箱 SMTP 授权码
QQ_EMAIL_PASSWORD="change-me"

RABBITMQ_URL="amqp://root:1234@localhost:5672"

# SSO 统一登录（sso_login 项目，授权码模式服务端换 token）
SSO_BASE_URL="http://127.0.0.1:8888"
SSO_CLIENT_ID="repo-cms"
SSO_CLIENT_SECRET="change-me"
# 授权回跳地址白名单（逗号分隔，须与 SSO 库 oauth_clients 注册一致）
SSO_REDIRECT_URIS="http://localhost:5174/#/landing/sso/callback"
