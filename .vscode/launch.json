    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bun master (with .env.devLocal)",
            "type": "bun",
            "request": "launch",
            "runtimeArgs": ["--env-file", "${workspaceFolder}/.env.devLocal"],
            "program": "${workspaceFolder}/src/index.ts",
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "neverOpen",
            "stopOnEntry": false,
            "watchMode": true,
            "noDebug": false
        }
    ]
}