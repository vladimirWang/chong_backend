{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bun Server",
            "type": "bun",
            "request": "launch",
            "program": "${workspaceFolder}/src/index.ts",
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "development"
            },
            "stopOnEntry": false,
            "watchMode": false,
            "noDebug": false
        },
        {
            "name": "Debug Bun worker (with .env.devLocal)",
            "type": "bun",
            "request": "launch",
            "runtimeArgs": ["--env-file", ".env.devLocal"],
            "program": "${workspaceFolder}/src/worker.ts",
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "neverOpen",
            "stopOnEntry": false,
            "watchMode": true,
            "noDebug": false
        },
        {
            "name": "Debug Bun master (with .env.devLocal)",
            "type": "bun",
            "request": "launch",
            "runtimeArgs": ["--env-file", ".env.devLocal"],
            "program": "${workspaceFolder}/src/index.ts",
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "neverOpen",
            "stopOnEntry": false,
            "watchMode": true,
            "noDebug": false
        }
    ]
}