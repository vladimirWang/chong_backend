{
  "name": "app",
  "version": "1.0.50",
  "scripts": {
    "test": "./test-setup.sh && bunx dotenv -e .env.test -- bun test",
    "test:setup": "./test-setup.sh",
    "dev": "bunx dotenv -e .env.development -- bun run --watch src/index.ts",
    "perf:http": "bun run perf/http_load.ts",
    "db:push": "bunx dotenv -e .env.development -- prisma db push",
    "migrate:dev": "bunx dotenv -e .env.development -- prisma migrate dev",
    "generate:dev": "bunx dotenv -e .env.development -- prisma generate",
    "reset:dev": "bunx dotenv -e .env.development -- prisma migrate reset",
    "seed:dev": "bunx dotenv -e .env.development -- prisma db seed",
    "seed:test": "bunx dotenv -e .env.test -- prisma db seed",
    "seed:prod": "bunx dotenv -e .env.prod -- prisma db seed"
  },
  "dependencies": {
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/static": "^1.4.7",
    "@prisma/adapter-mariadb": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@redis/client": "^5.11.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "elysia": "^1.4.27",
    "lodash": "^4.17.21",
    "nodemailer": "^7.0.13",
    "openai": "^6.33.0",
    "pino": "^9.5.0",
    "svg-captcha": "^1.4.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.6",
    "@types/lodash": "^4.17.23",
    "@types/nodemailer": "^7.0.11",
    "bun-types": "latest",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.4.2"
  },
  "module": "src/index.js"
}
