{
  "name": "gallery_hono",
  "scripts": {
    "test": "./test-setup.sh && bunx dotenv -e .env.test -- bun test",
    "test:setup": "./test-setup.sh",
    "dev:local:server": "bunx dotenv -e .env.devLocal -- bun run --watch src/index.ts",
    "dev:local:worker": "bunx dotenv -e .env.devLocal -- bun run --watch src/worker.ts",
    "dev:local": "concurrently -n server,worker -c blue,green npm:dev:local:server npm:dev:local:worker",
    "perf:http": "bun run perf/http_load.ts",
    "db:push": "bunx dotenv -e .env.dev -- prisma db push",
    "migrate:dev": "bunx dotenv -e .env.devLocal -- prisma migrate dev",
    "generate:dev": "bunx dotenv -e .env.devLocal -- prisma generate",
    "reset:dev": "bunx dotenv -e .env.dev -- prisma migrate reset",
    "seed:dev": "bunx dotenv -e .env.dev -- prisma db seed",
    "seed:test": "bunx dotenv -e .env.test -- prisma db seed",
    "seed:prod": "bunx dotenv -e .env.prod -- prisma db seed"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@hono/zod-validator": "^0.9.1",
    "@prisma/adapter-mariadb": "7.4.2",
    "@prisma/client": "7.4.2",
    "@redis/client": "5.11.0",
    "amqplib": "^2.0.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "nodemailer": "^7.0.13",
    "svg-captcha": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.11",
    "dotenv-cli": "^11.0.0",
    "prisma": "7.4.2"
  }
}