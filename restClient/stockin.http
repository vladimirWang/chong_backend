Content-Type: application/json
Authorization: {{token}}

{
    "remark": "importRemark",
    "productJoinStockIn": [
        {
            "cost": 100, 
            "count": 200,
            "productId": 1,
            "shelfPrice":1,
            "vendorId": 1
